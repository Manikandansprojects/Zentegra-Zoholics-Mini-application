			Disable as "Disable"
			{
				type =  form
				form = Industry

				record event = on add or edit

				on user input of Construction
				{
					actions 
					{
						custom deluge script
						(
											if(input.Construction == true)
										{
											disable Ecommerce;
											disable Education;
											disable Financial_Service;
											disable Health_Care;
											disable Hospitality_Services;
											disable IT_Services;
											disable Logistics;
											disable Manufacturing;
											disable Media_Entertainment;
											disable Non_Profit;
											disable Professional_Service;
											disable Real_Estate;
											disable Retail;
										}
										else
										{
											enable Ecommerce;
											enable Education;
											enable Financial_Service;
											enable Health_Care;
											enable Hospitality_Services;
											enable IT_Services;
											enable Logistics;
											enable Manufacturing;
											enable Media_Entertainment;
											enable Non_Profit;
											enable Professional_Service;
											enable Real_Estate;
											enable Retail;
										}
						)
					}
				}

			}
