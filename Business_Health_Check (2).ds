		default list All_Industries
		{
			displayName = "All Industries"
			show all rows from Industry    
			(
				Real_Estate as "Real Estate "
				Non_Profit as "Non - Profit"
				Hospitality_Services as "Hospitality Services"
				Manufacturing
				Construction
				Professional_Service as "Professional Service"
				Logistics
				Retail
				Ecommerce as "Ecommerce "
				IT_Services as "IT Services"
				Education
				Health_Care as "Health Care"
				Financial_Service as "Financial Service"
				Media_Entertainment as "Media & Entertainment"
				Organization
			)
		}
	}




		workflow
		{
		form
		{
			marketing as "marketing"
			{
				type =  form
				form = Real_Estate_Industry

				record event = on add or edit

