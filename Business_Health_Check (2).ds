		reports
		{
			report All_Real_Estate_Industries
			{
				quickview
				(
					layout
					(
		 				type = -1
						datablock1
						(
							layout type = -1
							fields
							(
								How_are_real_estate_leads_currently_captured_and_managed as "How Are Real Estate Leads Currently Captured And Managed?"
								Sales_Lead_Management1 as "Sales & Lead Management"
								Marketing1 as "Marketing"
								Property_Listing_Inventory as "Property Listing & Inventory"
								Site_Visit_Appointment_Management as "Site Visit / Appointment Management"
								Customer_Relationship_Management as "Customer Relationship Management"
								How_Are_Real_Estate_Marketing_Campaigns_Currently_Managed as "How Are Real Estate Marketing Campaigns Currently Managed?"
								Are_Leads_Automatically_Assigned_To_Sales_Agents_Or_Brokers_Based_On_Property_Type_Location_Budget as "Are Leads Automatically Assigned To Sales Agents Or Brokers Based On Property Type, Location, Budget, Or Availability?"
								What_Sales_Challenges_Affect_Real_Estate_Conversion as "What Sales Challenges Affect Real Estate Conversion?"
								Are_Customer_Requirements_Such_As_Budget_Property_Type_Preferred_Location_Amenities_And_Purchase_T as "Are Customer Requirements Such As Budget, Property Type, Preferred Location, Amenities, And Purchase Timeline Recorded In A Structured Format?"
								How_Are_Property_Listings_Units_Plots_Villas_Apartments_Or_Commercial_Spaces_Currently_Managed as "How Are Property Listings, Units, Plots, Villas, Apartments, Or Commercial Spaces Currently Managed?"
								Is_Management_Able_To_Track_Active_Leads_Hot_Prospects_Site_Visits_Bookings_Lost_Deals_And_Sales_T as "Is Management Able To Track Active Leads, Hot Prospects, Site Visits, Bookings, Lost Deals, And Sales Team Performance In Real Time?"
								Are_property_availability_booking_status_pricing_discounts_and_inventory_status_updated_in_real_time as "Are Property Availability, Booking Status, Pricing, Discounts, And Inventory Status Updated In Real Time?"
								What_Property_Inventory_Challenges_Occur_Frequently as "What Property Inventory Challenges Occur Frequently?"
								Are_property_documents_images_floor_plans_brochures_approvals_and_specifications_linked_to_each_pr as "Are Property Documents, Images, Floor Plans, Brochures, Approvals, And Specifications Linked To Each Property Record?"
								Are_leads_from_property_portals_website_forms_social_media_campaigns_walk_ins_and_referrals_automa as "Are Leads From Property Portals, Website Forms, Social Media Campaigns, Walk-Ins, And Referrals Automatically Captured Into CRM?"
								Are_Prospects_Segmented_Based_On_Budget_Location_Preference_Property_Type_Buying_Timeline_And_Enga as "Are Prospects Segmented Based On Budget, Location Preference, Property Type, Buying Timeline, And Engagement Level?"
								Are_Operational_Sales_Financial_and_Customer_Reports_Available_in_Real_Time as "Are Operational, Sales, Financial, and Customer Reports Available in Real Time?"
								What_Marketing_Challenges_Affect_Lead_Quality_And_Conversion as "What Marketing Challenges Affect Lead Quality And Conversion?"
								How_Are_Site_Visits_Property_Tours_and_Client_Appointments_Scheduled as "How Are Site Visits, Property Tours, and Client Appointments Scheduled"
								Are_Site_Visits_Connected_with_Lead_Records_Assigned_Agents_Property_Availability_and_Follow_Up_Ta as "Are Site Visits Connected with Lead Records, Assigned Agents, Property Availability, and Follow-Up Tasks?"
								What_Site_Visit_Challenges_Occur_Frequently as "What Site Visit Challenges Occur Frequently?"
