						custom deluge script
						(
											if(input.Construction == true)
										{
											openUrl("#Form:Construction_Industry","new window");
										}
										else if(input.Ecommerce == true)
										{
											openUrl("#Form:Ecommerce_Industry","new window");
										}
										else if(input.Education == true)
										{
											openUrl("#Form:Education_Industries","new window");
										}
										else if(input.Financial_Service == true)
										{
											openUrl("#Form:Financial_Services","new window");
										}
										else if(input.Health_Care == true)
										{
											openUrl("#Form:Health_Care","new window");
										}
										else if(input.Hospitality_Services == true)
										{
											openUrl("#Form:Hospitality_Services","new window");
										}
										else if(input.IT_Services == true)
										{
											openUrl("#Form:IT_Services_Industry","new window");
										}
										else if(input.Logistics == true)
										{
											openUrl("#Form:Logistics_Industry","new window");
										}
										else if(input.Manufacturing == true)
										{
											openUrl("#Form:Manufacturing_Industry","new window");
										}
										else if(input.Media_Entertainment == true)
										{
											openUrl("#Form:Media_Entertainment","new window");
										}
										else if(input.Non_Profit == true)
										{
											openUrl("#Form:Nonprofit_Industry","new window");
										}
										else if(input.Professional_Service == true)
										{
											openUrl("#Form:Professional_Services","new window");
										}
										else if(input.Real_Estate == true)
										{
											openUrl("#Form:Real_Estate_Industry","new window");
										}
										else if(input.Retail == true)
										{
											openUrl("#Form:Retail_Industry","new window");
										}
										else
										{
											info "You did not selected any industry yet.";
										}
						)
					}
				}

			}
